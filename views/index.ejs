<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        #meme-containor {
            width: 100%;
            max-width: 400px;
            margin: 20px auto;
        }
        #meme {
            width: 100%;
            height: auto;
            object-fit: contain;
            border-radius: 12px;
            border: 1px solid black;
        }
    </style>
</head>

<body>
    <h1>Meme Morning</h1>
    <div id="meme-containor">
        <img id="meme" src=<%= meme.url %> alt="meme">
    </div>
    <div>
        <button id="subscribe-btn">Subscribe</button>
        <button id="unsubscribe-btn">Unsubscribe</button>
    </div>
    <script type="module" src="/scripts/script.js"></script>
</body>

</html>